{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"configMigration": true,
	"dependencyDashboard": {
		"enabled": true
	},
	"rangeStrategy": "pin",
	"packageRules": [
		{
			"matchPackageNames": [
				"fastlane",
				"aws-sdk"
			],
			"enabled": false
		}
	]
}

